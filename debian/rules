#!/usr/bin/make -f
# The DEB counterpart of drime-desktop.spec: same files, same places.
include /usr/share/dpkg/pkg-info.mk
D = debian/drime-desktop
PYDIR = $(D)/usr/lib/python3/dist-packages/drime_desktop

%:
	dh $@ --with python3

# The top-level Makefile drives package builds; it is not a build system.
override_dh_auto_build override_dh_auto_clean override_dh_auto_test:

override_dh_auto_install:
	install -d $(PYDIR)
	install -m 0644 src/drime_desktop/*.py $(PYDIR)/
	sed -i 's/@VERSION@/$(DEB_VERSION_UPSTREAM)/' $(PYDIR)/__init__.py
	install -D -m 0755 bin/drime-desktop $(D)/usr/bin/drime-desktop
	install -D -m 0644 systemd/rclone-drime-mount.service $(D)/usr/lib/systemd/user/rclone-drime-mount.service
	install -D -m 0644 systemd/drime-bisync.service       $(D)/usr/lib/systemd/user/drime-bisync.service
	install -D -m 0644 systemd/drime-bisync.timer         $(D)/usr/lib/systemd/user/drime-bisync.timer
	install -D -m 0644 desktop/io.github.davethegamedev.DrimeDesktop.desktop $(D)/usr/share/applications/io.github.davethegamedev.DrimeDesktop.desktop
	install -D -m 0644 assets/drime.png $(D)/usr/share/icons/hicolor/512x512/apps/drime-desktop.png
	install -D -m 0644 assets/io.github.davethegamedev.DrimeDesktop.metainfo.xml \
	    $(D)/usr/share/metainfo/io.github.davethegamedev.DrimeDesktop.metainfo.xml
	desktop-file-validate $(D)/usr/share/applications/*.desktop
	appstreamcli validate --no-net $(D)/usr/share/metainfo/*.xml

# The units are enabled per user by the app (like the RPM); never system-wide.
override_dh_installsystemduser:
